# Required at runtime. Add this variable to every Vercel environment that serves the store.
DATABASE_URL="postgresql://zarshal:CHANGE_ME@localhost:5432/zarshal?schema=public"
# For hosted poolers such as Supabase, use the session/direct URL for migrations.
DIRECT_URL=""
APP_URL="http://localhost:3000"
SITE_URL="https://zalmi.pk"
ADMIN_EMAIL="admin@zarshal.local"
# At least 12 characters; used only when seeding the first administrator.
ADMIN_PASSWORD="CHANGE_THIS_DEVELOPMENT_PASSWORD"
UPLOAD_DRIVER="local"
# Set UPLOAD_DRIVER=cloudinary for production object storage.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
